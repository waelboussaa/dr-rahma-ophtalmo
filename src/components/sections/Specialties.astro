---
import { Eye, Aperture, ScanEye, Layers, Activity, Baby, ArrowUpRight, Check } from "@lucide/astro";
import SpecialtyImage from "../site/SpecialtyImage.astro";
import { sections, makeT, type Locale, type TranslationKey } from "../../lib/i18n";
import { specialties } from "../../content/practice";
import { medtnHref } from "../../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const icons = { Eye, Aperture, ScanEye, Layers, Activity, Baby } as const;

const actsAr: Record<string, string> = {
  "Ophtalmologie de l'adulte": "طب وجراحة عيون الكبار",
  "Ophtalmopédiatrie": "طب عيون الأطفال والرضع",
  "Mesure de la pression intraoculaire": "قياس ومتابعة ضغط العين",
  "Fond d'oeil": "فحص قاع العين والشبكية",
  "Cataracte premium": "جراحة الساد الحديثة بالموجات (الفاكو)",
  "Cataracte congénitale": "جراحة الساد الخلقي",
  "Cataracte traumatique": "علاج الساد الرضحي",
  "Implants premium de chirurgie de cataracte": "زراعة عدسات Premium في جراحة الساد",
  "Chirurgie réfractive par LASIK": "تصحيح النظر بالليزك (LASIK)",
  "Chirurgie réfractive par PKR": "تصحيح النظر السطحي (PKR)",
  "Correction réfractive (hypermétropie, myopie, astigmatisme) par laser SMILE": "تصحيح النظر بتقنية سمايل (SMILE)",
  "Topographie et topo-tomographie cornéenne": "طبوغرافيا دقيقة لسطح القرنية",
  "Kératocône": "تشخيص ومتابعة القرنية المخروطية",
  "Cross-linking cornéen (CXL)": "تثبيت القرنية بالأشعة (Cross-linking)",
  "OCT et OCT-A": "التصوير المقطعي للشبكية (OCT / OCT-A)",
  "OCT Swept Source": "تصوير مقطعي متقدم للشبكية",
  "Angiographie rétinienne numérique": "تصوير الأوعية الشبكية الرقمي",
  "DMLA (dégénérescence maculaire liée à l'âge)": "علاج التنكس البقعي واعتلال الشبكية",
  "Rétinopathie diabétique": "علاج ومتابعة اعتلال الشبكية السكري",
  "Champ visuel Humphrey": "فحص مجال الرؤية وعلاج الزرق",
  "Maladies des yeux chez l'enfant": "أمراض عيون الأطفال والرضع",
  "Strabologie": "تشخيص وعلاج ومتابعة الحول",
  "Chirurgie du strabisme": "جراحة تصحيح الحول",
  "Amblyopie": "الكشف المبكر وعلاج كسل العين",
};
---

<section id={sections.specialties} class="section-y bg-sand-soft/30">
  {/* The leaf mask definition */}
  <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute">
    <defs>
      <clipPath id="specialty-leaf" clipPathUnits="objectBoundingBox">
        <path
          d="M 0.40,0 L 0.94,0 C 0.974,0 1,0.026 1,0.06 L 1,0.60 C 1,0.821 0.821,1 0.60,1 L 0.06,1 C 0.026,1 0,0.974 0,0.94 L 0,0.40 C 0,0.179 0.179,0 0.40,0 Z"
        ></path>
      </clipPath>
    </defs>
  </svg>

  <div class="wrap">
    <div class="reveal flex flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1 text-[0.82rem] font-semibold uppercase tracking-wider text-bronze-deep shadow-sm">
        {t("specialties.eyebrow")}
      </span>
      <h2 class="h2 mt-4 max-w-[24ch]">{t("specialties.title")}</h2>
      <p class="lead mt-4 max-w-[54ch] text-ink-muted">{t("specialties.lead")}</p>
    </div>

    {/* 6 Treatment Cards Grid matching drasiri.com */}
    <div class="reveal mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        specialties.map((spec, i) => {
          const Icon = icons[spec.icon as keyof typeof icons];
          return (
            <div
              id={spec.id}
              class="group relative flex scroll-mt-28 flex-col justify-between overflow-hidden rounded-plate border border-line bg-surface p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-bronze hover:shadow-md text-start"
            >
              <div>
                {/* Header row: Number, Icon, and leaf image preview */}
                <div class="flex items-start justify-between gap-3">
                  <div class="flex flex-col gap-3">
                    <span class="font-display text-sm font-bold text-bronze-deep" aria-hidden="true">
                      <bdi dir="ltr">{String(i + 1).padStart(2, "0")}</bdi>
                    </span>
                    <div class="grid h-12 w-12 place-items-center rounded-2xl bg-sand-soft text-bronze-deep transition-colors group-hover:bg-ink group-hover:text-cream">
                      <Icon size={26} aria-hidden="true" stroke-width={1.5} />
                    </div>
                  </div>

                  <SpecialtyImage
                    id={spec.id}
                    alt={t(`spec.${spec.id}.alt` as TranslationKey)}
                    class="w-[44%] shrink-0"
                  />
                </div>

                <div class="mt-6">
                  <h3 class="font-display text-[1.24rem] leading-snug text-ink font-semibold transition-colors group-hover:text-bronze-deep">
                    {t(`spec.${spec.id}.name` as TranslationKey)}
                  </h3>
                  <p class="mt-3 text-[0.91rem] leading-relaxed text-ink-muted">
                    {t(`spec.${spec.id}.text` as TranslationKey)}
                  </p>
                </div>

                {/* Verified acts list */}
                {spec.backedBy.length > 0 && (
                  <div class="mt-5 border-t border-line/50 pt-4">
                    <p class="text-[0.74rem] font-bold uppercase tracking-wider text-bronze-deep">
                      {t("spec.actsLabel")}
                    </p>
                    <ul class="mt-2.5 flex flex-col gap-1.5 text-[0.82rem] text-ink-muted">
                      {spec.backedBy.slice(0, 3).map((act) => {
                        const actText = locale === "ar" ? (actsAr[act] ?? act) : act;
                        return (
                          <li class="flex items-start gap-2">
                            <Check size={13} aria-hidden="true" class="mt-1 shrink-0 text-bronze" />
                            <span class="leading-tight">{actText}</span>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}
              </div>

              {/* Direct booking. The "En savoir plus" link that used to sit
                  beside this pointed at a per-specialty page
                  (/consultation, /cataracte, ...); those pages were removed,
                  so this button now has the row to itself. */}
              <div class="mt-6 pt-4 border-t border-line/40 flex items-center justify-end gap-2">
                <a
                  href={medtnHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-full bg-sand-soft px-3.5 py-1.5 text-[0.82rem] font-semibold text-ink transition-colors hover:bg-ink hover:text-cream"
                >
                  <span>{t("cta.book")}</span>
                  <ArrowUpRight size={13} aria-hidden="true" class="rtl:-scale-x-100" />
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    {/* Bottom conversion strip */}
    <div class="reveal mt-12 flex flex-col items-center justify-between gap-5 rounded-plate border border-line bg-surface p-7 sm:flex-row sm:px-10 shadow-sm">
      <p class="font-display text-[1.15rem] leading-snug text-ink text-center sm:text-start">
        {t("specialties.ctaLead")}
      </p>
      <a
        href={medtnHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-pill-icon shrink-0"
      >
        <span>{t("cta.book")}</span>
        <span class="btn-icon-circle">
          <ArrowUpRight size={15} aria-hidden="true" class="rtl:-scale-x-100 text-ink" />
        </span>
        <span class="sr-only">({t("a11y.newTab")})</span>
      </a>
    </div>
  </div>
</section>
