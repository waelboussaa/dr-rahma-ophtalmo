---
import { Phone, MessageCircle, Navigation, Clock, MapPin, BadgeCheck } from "@lucide/astro";
import MapPanel from "../site/MapPanel.astro";
import { sections, makeT, type Locale } from "../../lib/i18n";
import { telHref, whatsappHref, mapsHref } from "../../lib/links";
import { cabinet } from "../../content/practice";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const name = locale === "ar" ? cabinet.nameAr.value : cabinet.nameFr.value;
const lines = locale === "ar" ? cabinet.addressLinesAr.value : cabinet.addressLinesFr.value;
const landmark = locale === "ar" ? cabinet.landmarkAr.value : cabinet.landmarkFr.value;
---

<section id={sections.cabinet} class="section-y bg-sand-soft/30">
  <div class="wrap">
    <div class="grid items-start gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Left Column: Address, Hours, Actions */}
      <div class="reveal lg:col-span-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1 text-[0.82rem] font-semibold uppercase tracking-wider text-bronze-deep shadow-sm">
          {t("cabinet.eyebrow")}
        </span>

        <h2 class="h2 mt-4">{t("cabinet.title")}</h2>

        <div class="mt-9 grid gap-6 sm:grid-cols-2">
          {/* Address card */}
          <div class="rounded-plate border border-line bg-surface p-6 shadow-xs flex flex-col justify-between">
            <div>
              <h3 class="field-label flex items-center gap-2 text-ink-muted">
                <MapPin size={15} aria-hidden="true" class="text-bronze-deep" />
                {t("cabinet.addressLabel")}
              </h3>
              <address class="mt-4 text-[0.93rem] leading-[1.8] not-italic text-ink-muted">
                <span class="block font-semibold text-ink">{name}</span>
                {lines.map((line) => <span class="block">{line}</span>)}
              </address>
            </div>
            <div class="mt-4 border-t border-line/50 pt-3">
              <span class="flex items-center gap-1.5 text-[0.82rem] font-medium text-bronze-deep">
                <MapPin size={13} aria-hidden="true" class="shrink-0 text-bronze" />
                <span>{landmark}</span>
              </span>
            </div>
          </div>

          {/* Hours card */}
          <div class="rounded-plate border border-line bg-surface p-6 shadow-xs flex flex-col justify-between">
            <div>
              <h3 class="field-label flex items-center gap-2 text-ink-muted">
                <Clock size={15} aria-hidden="true" class="text-bronze-deep" />
                {t("cabinet.hoursLabel")}
              </h3>
              <p class="mt-4 text-[0.93rem] leading-[1.8] text-ink-muted">
                <span class="block font-semibold text-ink">{t("cabinet.hoursDays")}</span>
                <span class="block font-medium"><bdi dir="ltr">{t("cabinet.hoursTime")}</bdi></span>
              </p>
              <p class="mt-3 text-[0.84rem] text-ink-muted">
                {locale === "ar" ? "استقبال المرضى بالمواعيد" : "Accueil des patients sur rendez-vous"}
              </p>
            </div>

            <div class="mt-4 border-t border-line/50 pt-3">
              <span class="inline-flex items-center gap-1.5 text-[0.82rem] font-semibold text-bronze-deep">
                <BadgeCheck size={16} aria-hidden="true" />
                {t("cabinet.cnam")}
              </span>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={telHref} class="btn btn-primary">
            <Phone size={16} aria-hidden="true" />
            <span>{t("cta.call")}</span>
          </a>
          <a
            href={whatsappHref(t("wa.message"))}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <MessageCircle size={16} aria-hidden="true" />
            <span>{t("cta.whatsapp")}</span>
          </a>
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <Navigation size={16} aria-hidden="true" />
            <span>{t("cta.directions")}</span>
          </a>
        </div>
      </div>

      {/* Right Column: Interactive Map */}
      <div class="reveal lg:col-span-6 flex flex-col justify-stretch" data-reveal-delay="100">
        <MapPanel locale={locale} class="w-full flex-1" />
      </div>
    </div>
  </div>
</section>
