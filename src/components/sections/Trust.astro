---
import { Aperture, Activity, ScanEye, Eye, ArrowUpRight, ArrowDown } from "@lucide/astro";
import { anchor, makeT, type Locale } from "../../lib/i18n";
import { medtnHref } from "../../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const services = [
  {
    icon: Aperture,
    titleKey: "trust.ophtalmologie.title",
    textKey: "trust.ophtalmologie.text",
    tagKey: "chirurgie",
  },
  {
    icon: Activity,
    titleKey: "trust.chirurgie.title",
    textKey: "trust.chirurgie.text",
    tagKey: "retine",
  },
  {
    icon: ScanEye,
    titleKey: "trust.laser.title",
    textKey: "trust.laser.text",
    tagKey: "laser",
  },
  {
    icon: Eye,
    titleKey: "trust.approche.title",
    textKey: "trust.approche.text",
    tagKey: "soins",
  },
] as const;

const tags = {
  chirurgie: { fr: "Chirurgie", ar: "جراحة" },
  retine: { fr: "Rétine", ar: "شبكية" },
  laser: { fr: "Laser", ar: "ليزر" },
  soins: { fr: "Soins", ar: "رعاية" },
} as const;
---

<section class="section-y bg-sand-soft/40">
  <div class="wrap">
    <div class="reveal flex flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1 text-[0.82rem] font-semibold uppercase tracking-wider text-bronze-deep shadow-sm">
        {t("trust.eyebrow")}
      </span>
      <h2 class="h2 mt-4 max-w-[22ch]">{t("trust.heading")}</h2>
      <p class="lead mt-4 max-w-[50ch] text-ink-muted">{t("trust.lead")}</p>
    </div>

    <div class="reveal mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((item) => (
          <div class="group relative flex flex-col justify-between rounded-plate border border-line bg-surface p-7 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-bronze hover:shadow-md text-start">
            <div>
              <div class="flex items-center justify-between">
                <div class="grid h-13 w-13 place-items-center rounded-2xl bg-sand/60 text-bronze-deep transition-colors group-hover:bg-ink group-hover:text-cream">
                  <item.icon size={26} aria-hidden="true" stroke-width={1.6} />
                </div>
                <span class="rounded-full bg-sand-soft px-2.5 py-0.5 text-[0.74rem] font-semibold text-bronze-deep">
                  {tags[item.tagKey][locale]}
                </span>
              </div>

              <h3 class="font-display mt-6 text-[1.18rem] leading-snug text-ink transition-colors group-hover:text-bronze-deep">
                {t(item.titleKey)}
              </h3>
              <p class="mt-3 text-[0.91rem] leading-relaxed text-ink-muted">
                {t(item.textKey)}
              </p>
            </div>

            <div class="mt-6 border-t border-line/50 pt-4">
              <a
                href={medtnHref}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-1.5 text-[0.84rem] font-semibold text-ink transition-colors group-hover:text-bronze-deep"
              >
                <span>{t("cta.book")}</span>
                <ArrowUpRight size={14} aria-hidden="true" class="rtl:-scale-x-100 text-bronze-deep" />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a href={anchor("specialties")} class="btn btn-ghost inline-flex items-center gap-2">
        <span>{t("trust.allServices")}</span>
        <ArrowDown size={15} aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
