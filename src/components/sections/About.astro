---
import { ArrowUpRight, BadgeCheck, CircleCheck } from "@lucide/astro";
import Portrait from "../site/Portrait.astro";
import { sections, makeT, type Locale } from "../../lib/i18n";
import { medtnHref } from "../../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const credentials = [
  "about.cred1",
  "about.cred2",
  "about.cred3",
  "about.cred4",
  "about.cred5",
  "about.cred6",
] as const;
---

<section id={sections.about} class="section-y bg-cream">
  <div class="wrap">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      {/* Visual column with decorative circular spin and badge */}
      <div class="reveal relative lg:col-span-5">
        <div class="pointer-events-none absolute -bottom-8 -start-8 h-36 w-36 animate-spin-slow opacity-25 md:h-48 md:w-48" aria-hidden="true">
          <svg viewBox="0 0 100 100" fill="none" class="h-full w-full stroke-bronze" stroke-width="1.2" stroke-dasharray="4 6">
            <circle cx="50" cy="50" r="44" />
          </svg>
        </div>

        <div class="relative mx-auto max-w-[22rem] lg:max-w-none">
          <Portrait locale={locale} ratio="4/5" class="shadow-sm" />

          <div class="absolute -bottom-4 inset-x-4 z-10 flex items-center justify-between rounded-plate border border-line bg-surface/95 px-4 py-3 shadow-md backdrop-blur-sm text-start">
            <div class="flex items-center gap-2.5">
              <BadgeCheck size={20} aria-hidden="true" class="shrink-0 text-bronze-deep" />
              <div>
                <span class="block text-[0.84rem] font-bold text-ink">{t("cabinet.cnam")}</span>
                <span class="block text-[0.74rem] text-ink-muted">{t("hero.floatingBadge1")}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Text column */}
      <div class="reveal lg:col-span-7 text-start" data-reveal-delay="100">
        <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1 text-[0.82rem] font-semibold uppercase tracking-wider text-bronze-deep shadow-sm">
          {t("about.eyebrow")}
        </span>

        <h2 class="h2 mt-4 max-w-[22ch]">{t("about.title")}</h2>

        <p class="mt-6 font-display text-[1.35rem] leading-snug text-ink md:text-[1.55rem]">
          {t("about.statement")}
        </p>

        <div class="mt-6 flex flex-col gap-3 text-[0.95rem] leading-relaxed text-ink-muted">
          <p>{t("about.p1")}</p>
          <p>{t("about.p2")}</p>
          <p class="font-medium text-ink">{t("about.p3")}</p>
        </div>

        {/* Credentials Grid from drasiri.com */}
        <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {
            credentials.map((credKey) => (
              <div class="flex items-center gap-2.5 rounded-xl border border-line/80 bg-surface/80 p-3 shadow-xs backdrop-blur-sm">
                <CircleCheck size={16} aria-hidden="true" class="shrink-0 text-bronze-deep" />
                <span class="text-[0.86rem] font-semibold text-ink">{t(credKey)}</span>
              </div>
            ))
          }
        </div>

        <div class="mt-9">
          <a
            href={medtnHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-pill-icon"
          >
            <span>{t("cta.book")}</span>
            <span class="btn-icon-circle">
              <ArrowUpRight size={16} aria-hidden="true" class="rtl:-scale-x-100 text-ink" />
            </span>
            <span class="sr-only">({t("a11y.newTab")})</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
