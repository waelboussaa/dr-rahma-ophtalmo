---
import { MapPin, Phone, Clock, CalendarCheck2, ArrowUpRight } from "@lucide/astro";
import { makeT, type Locale } from "../../lib/i18n";
import { telHref, telDisplay, medtnHref } from "../../lib/links";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
---

<section class="relative z-20 py-6 md:py-8 bg-cream">
  <div class="wrap">
    <div class="reveal grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {/* Card 1: Address */}
      <div class="flex items-start gap-4 rounded-plate border border-line bg-surface p-5 shadow-xs transition-transform duration-200 hover:-translate-y-1 text-start">
        <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sand-soft text-bronze-deep">
          <MapPin size={20} aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-[0.82rem] font-bold uppercase tracking-wider text-bronze-deep">
            {t("quickinfo.addressTitle")}
          </h3>
          <p class="mt-1 text-[0.92rem] leading-snug text-ink font-medium">
            {t("quickinfo.addressText")}
          </p>
        </div>
      </div>

      {/* Card 2: Phone */}
      <div class="flex items-start gap-4 rounded-plate border border-line bg-surface p-5 shadow-xs transition-transform duration-200 hover:-translate-y-1 text-start">
        <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sand-soft text-bronze-deep">
          <Phone size={20} aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-[0.82rem] font-bold uppercase tracking-wider text-bronze-deep">
            {t("quickinfo.phoneTitle")}
          </h3>
          <a
            href={telHref}
            class="mt-1 block text-[1rem] leading-snug font-semibold text-ink transition-colors hover:text-bronze-deep"
          >
            <bdi dir="ltr">{telDisplay}</bdi>
          </a>
        </div>
      </div>

      {/* Card 3: Hours */}
      <div class="flex items-start gap-4 rounded-plate border border-line bg-surface p-5 shadow-xs transition-transform duration-200 hover:-translate-y-1 text-start">
        <div class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-sand-soft text-bronze-deep">
          <Clock size={20} aria-hidden="true" />
        </div>
        <div>
          <h3 class="text-[0.82rem] font-bold uppercase tracking-wider text-bronze-deep">
            {t("quickinfo.hoursTitle")}
          </h3>
          <p class="mt-1 text-[0.92rem] leading-snug text-ink font-medium">
            {t("quickinfo.hoursText")}
          </p>
        </div>
      </div>

      {/* Card 4: Quick consultation booking CTA */}
      <div class="flex flex-col justify-between rounded-plate border border-bronze/40 bg-sand-soft p-5 shadow-xs transition-transform duration-200 hover:-translate-y-1 text-start">
        <div class="flex items-start gap-3">
          <div class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-cream text-bronze-deep">
            <CalendarCheck2 size={18} aria-hidden="true" />
          </div>
          <div>
            <h3 class="text-[0.88rem] font-bold text-ink">
              {t("quickinfo.bookingTitle")}
            </h3>
            <p class="text-[0.78rem] text-ink-muted">
              {t("quickinfo.bookingText")}
            </p>
          </div>
        </div>

        <div class="mt-3">
          <a
            href={medtnHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-between rounded-full bg-ink px-4 py-2 text-[0.82rem] font-semibold text-cream transition-colors hover:bg-ink-soft"
          >
            <span>{t("quickinfo.bookingBtn")}</span>
            <ArrowUpRight size={14} aria-hidden="true" class="rtl:-scale-x-100" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
