---
import { sections, makeT, type Locale, type TranslationKey } from "../../lib/i18n";
import { journeySteps } from "../../content/practice";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
---

<section id={sections.journey} class="section-y bg-cream">
  <div class="wrap">
    <div class="reveal flex flex-col items-center text-center">
      <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-1 text-[0.82rem] font-semibold uppercase tracking-wider text-bronze-deep shadow-sm">
        {t("journey.eyebrow")}
      </span>
      <h2 class="h2 mt-4 max-w-[22ch]">{t("journey.title")}</h2>
      <p class="lead mt-4 max-w-[52ch] text-ink-muted">{t("journey.lead")}</p>
    </div>

    {/* 5 Process Cards matching drasiri.com */}
    <div class="reveal mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {
        journeySteps.map((stepKey, idx) => (
          <div class="group relative flex flex-col justify-between rounded-plate border border-line bg-surface p-6 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-bronze hover:shadow-md text-start">
            <div>
              <div class="flex items-center justify-between">
                <span class="font-display text-2xl font-bold text-bronze-deep transition-colors group-hover:text-ink">
                  <bdi dir="ltr">{String(idx + 1).padStart(2, "0")}</bdi>
                </span>
                <span class="h-2 w-2 rounded-full bg-bronze/50 group-hover:bg-bronze transition-colors"></span>
              </div>

              <h3 class="font-display mt-5 text-[1.12rem] leading-snug text-ink font-semibold">
                {t(`journey.${stepKey}.name` as TranslationKey)}
              </h3>

              <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-muted">
                {t(`journey.${stepKey}.text` as TranslationKey)}
              </p>
            </div>

            <div class="mt-6 h-1 w-8 rounded-full bg-sand transition-all duration-300 group-hover:w-full group-hover:bg-bronze"></div>
          </div>
        ))
      }
    </div>
  </div>
</section>
