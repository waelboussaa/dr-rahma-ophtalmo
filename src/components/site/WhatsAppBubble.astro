---
import { X, Send, ArrowUpRight } from "@lucide/astro";
import { makeT, type Locale } from "../../lib/i18n";
import { whatsappHref } from "../../lib/links";
import EyeMark from "../brand/EyeMark.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);

const defaultHref = whatsappHref(t("wa.message"));
const rdvHref = whatsappHref(
  locale === "ar"
    ? "السلام عليكم دكتورة، أرغب في حجز موعد بالعيادة."
    : "Bonjour Docteur, je souhaite prendre un rendez-vous au cabinet."
);
const infoHref = whatsappHref(
  locale === "ar"
    ? "السلام عليكم، أود الاستفسار عن موقع العيادة وأوقات العمل."
    : "Bonjour, je souhaite des renseignements sur l'accès et les horaires du cabinet."
);
---

{/* Desktop only. Below lg the sticky dock already carries a WhatsApp button, and
    a second one floating above it put two identical routes a thumb apart. */}
<div id="whatsapp-widget" class="no-print fixed bottom-10 end-8 z-40 hidden lg:block">
  {/* Chat Popover Card */}
  <div
    id="whatsapp-chat-card"
    class="pointer-events-none absolute bottom-full mb-3.5 end-0 w-[calc(100vw-2.5rem)] sm:w-[21rem] origin-bottom-right rtl:origin-bottom-left scale-95 opacity-0 transition-all duration-300 shadow-2xl rounded-3xl overflow-hidden border border-line bg-surface"
    role="dialog"
    aria-hidden="true"
    aria-labelledby="wa-card-title"
  >
    {/* Card Header */}
    <div class="bg-[#075E54] px-4 py-3.5 text-white flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <div class="relative grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 p-1">
          <EyeMark size={28} tone="mono" />
          <span class="absolute bottom-0 end-0 h-2.5 w-2.5 rounded-full bg-[#25D366] border-2 border-[#075E54]"></span>
        </div>
        <div>
          <h3 id="wa-card-title" class="text-[0.90rem] font-bold leading-tight">
            Dr Rahma Saidane Bourogaa
          </h3>
          <p class="text-[0.74rem] text-white/80">
            {t("wa.bubbleSubtitle")}
          </p>
        </div>
      </div>

      <button
        type="button"
        id="whatsapp-card-close"
        class="grid h-7 w-7 place-items-center rounded-full text-white/80 hover:bg-white/15 hover:text-white transition-all duration-200 hover:rotate-90 active:scale-90"
        aria-label={t("a11y.close")}
      >
        <X size={16} aria-hidden="true" />
      </button>
    </div>

    {/* Chat Message Bubble Body */}
    <div class="bg-[#e5ddd5]/30 dark:bg-sand-soft/30 p-4 flex flex-col gap-3">
      <div class="relative max-w-[92%] rounded-2xl rounded-ts-xs bg-surface p-3.5 shadow-2xs border border-line/60">
        <p class="text-[0.84rem] text-ink leading-relaxed">
          {t("wa.bubbleGreeting")}
        </p>
        <div class="mt-1.5 flex items-center justify-end gap-1 text-[0.68rem] text-ink-muted">
          <span>08:00 - 18:00</span>
          <span class="text-[#34B7F1]" aria-hidden="true">✓✓</span>
        </div>
      </div>

      {/* Quick Prompts */}
      <div class="flex flex-col gap-1.5 pt-1">
        <a
          href={rdvHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group/btn flex items-center justify-between rounded-xl border border-line bg-surface/90 px-3 py-2 text-[0.80rem] font-medium text-ink transition-all duration-200 hover:bg-sand-soft hover:border-bronze hover:translate-x-1 rtl:hover:-translate-x-1 hover:shadow-xs"
        >
          <span>📅 {t("wa.quickRdv")}</span>
          <ArrowUpRight size={13} aria-hidden="true" class="rtl:-scale-x-100 text-ink-muted transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 rtl:group-hover/btn:-translate-x-0.5" />
        </a>

        <a
          href={infoHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group/btn flex items-center justify-between rounded-xl border border-line bg-surface/90 px-3 py-2 text-[0.80rem] font-medium text-ink transition-all duration-200 hover:bg-sand-soft hover:border-bronze hover:translate-x-1 rtl:hover:-translate-x-1 hover:shadow-xs"
        >
          <span>📍 {t("wa.quickInfo")}</span>
          <ArrowUpRight size={13} aria-hidden="true" class="rtl:-scale-x-100 text-ink-muted transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 rtl:group-hover/btn:-translate-x-0.5" />
        </a>
      </div>
    </div>

    {/* Card Action Footer */}
    <div class="p-3 bg-surface border-t border-line/60">
      <a
        href={defaultHref}
        target="_blank"
        rel="noopener noreferrer"
        class="group/send flex w-full items-center justify-center gap-2 rounded-2xl bg-[#25D366] px-4 py-2.5 text-[0.86rem] font-bold text-white shadow-md transition-all duration-200 hover:bg-[#20ba59] hover:shadow-[0_8px_20px_-3px_rgba(37,211,102,0.5)] hover:scale-[1.02] active:scale-98"
      >
        <Send size={15} aria-hidden="true" class="transition-transform duration-200 group-hover/send:translate-x-1 group-hover/send:-translate-y-0.5 rtl:group-hover/send:-translate-x-1" />
        <span>{t("wa.openChat")}</span>
      </a>
    </div>
  </div>

  {/* Floating WhatsApp Action Button */}
  <button
    id="whatsapp-bubble-trigger"
    type="button"
    class="group relative flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-all duration-300 ease-out hover:-translate-y-1.5 hover:scale-110 hover:bg-[#20ba59] hover:shadow-[0_16px_36px_-6px_rgba(37,211,102,0.55),0_0_20px_rgba(37,211,102,0.35)] hover:ring-4 hover:ring-[#25D366]/35 active:scale-95 active:translate-y-0 focus:outline-none"
    aria-label={t("wa.bubbleTitle")}
    aria-expanded="false"
  >
    {/* Active Pulse Ring */}
    <span class="absolute inline-flex h-full w-full rounded-full bg-[#25D366] opacity-30 animate-ping group-hover:opacity-60 transition-opacity"></span>

    {/* Official WhatsApp SVG Vector Icon with Hover Wiggle */}
    <svg
      class="wa-bubble-icon relative z-10 h-7 w-7 text-white transition-transform duration-300 ease-out"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.37C9.37 7.37 9.1 7.43 8.88 7.67C8.65 7.91 8.03 8.49 8.03 9.68C8.03 10.87 8.9 12.01 9.02 12.17C9.14 12.33 10.71 14.75 13.13 15.79C13.71 16.04 14.15 16.19 14.51 16.3C15.09 16.49 15.62 16.46 16.03 16.4C16.5 16.33 17.46 15.82 17.66 15.26C17.86 14.7 17.86 14.22 17.8 14.13C17.74 14.03 17.58 13.97 17.35 13.86C17.12 13.75 15.99 13.19 15.78 13.11C15.57 13.03 15.42 12.99 15.27 13.22C15.11 13.46 14.67 13.97 14.53 14.13C14.4 14.29 14.26 14.31 14.03 14.2C13.8 14.09 12.87 13.78 11.77 12.8C10.91 12.03 10.33 11.08 10.17 10.81C10.01 10.54 10.15 10.4 10.27 10.28C10.37 10.18 10.5 10 10.61 9.87C10.73 9.74 10.77 9.64 10.85 9.48C10.93 9.32 10.89 9.18 10.83 9.06C10.77 8.94 10.33 7.82 10.13 7.37C9.94 6.91 9.74 6.99 9.58 6.98L9.53 7.37Z" />
    </svg>

    {/* Animated Tooltip (Desktop only, spring entrance with pointer) */}
    <div class="pointer-events-none absolute bottom-full mb-3 end-0 hidden sm:flex items-center gap-2 whitespace-nowrap rounded-full bg-ink px-3.5 py-1.5 text-[0.76rem] font-semibold text-cream shadow-xl opacity-0 translate-y-2 scale-90 group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-300 ease-out border border-sand-ink/20">
      <span class="h-2 w-2 rounded-full bg-[#25D366] animate-pulse"></span>
      <span>{t("wa.bubbleTitle")}</span>
      {/* Downward indicator triangle */}
      <span class="absolute -bottom-1 end-5 h-2 w-2 rotate-45 bg-ink border-r border-b border-sand-ink/20"></span>
    </div>
  </button>
</div>

<style>
  /* Phone wiggle / vibration micro-animation on hover */
  @keyframes wa-phone-wiggle {
    0%, 100% {
      transform: rotate(0deg) scale(1);
    }
    15% {
      transform: rotate(14deg) scale(1.12);
    }
    30% {
      transform: rotate(-12deg) scale(1.12);
    }
    45% {
      transform: rotate(10deg) scale(1.1);
    }
    60% {
      transform: rotate(-6deg) scale(1.06);
    }
    75% {
      transform: rotate(4deg) scale(1.03);
    }
  }

  #whatsapp-bubble-trigger:hover .wa-bubble-icon {
    animation: wa-phone-wiggle 0.85s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    #whatsapp-bubble-trigger:hover .wa-bubble-icon {
      animation: none;
    }
  }
</style>
