---
import { Menu, X } from "@lucide/astro";
import { makeT, type Locale } from "../../lib/i18n";

/**
 * The hamburger button only. The panel it controls is a SEPARATE component,
 * `MobileNavPanel.astro`, rendered as a sibling of <header> rather than inside
 * it.
 *
 * They are split on purpose and must stay split. The header carries
 * `backdrop-blur-lg`, and a `backdrop-filter` makes an element the containing
 * block for every `position: fixed` descendant. With the panel inside the
 * header, `fixed inset-0` resolved against the header's 64px box instead of the
 * viewport: the overlay opened as a 64px strip with 607px of menu scrolled out
 * of sight, so tapping the button appeared to do nothing.
 *
 * Nothing in the markup hints at that, which is why it is written here. If the
 * two are ever merged back into one component, the bug returns silently.
 *
 * The two halves are wired by data attributes, which the panel's script queries
 * from `document`, so their position in the tree does not matter.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
---

<button
  type="button"
  class="btn btn-ghost -me-1 h-11 w-11 min-h-11 shrink-0 !px-0 lg:hidden"
  aria-label={t("a11y.openMenu")}
  aria-expanded="false"
  aria-controls="mobile-nav"
  data-nav-toggle
>
  <Menu size={20} aria-hidden="true" data-icon-open />
  <X size={20} aria-hidden="true" class="hidden" data-icon-close />
</button>
