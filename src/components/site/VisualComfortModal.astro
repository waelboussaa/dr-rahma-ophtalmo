---
import { Eye, Type, Sparkles, X, RotateCcw, SlidersVertical, Compass } from "@lucide/astro";
import { makeT, type Locale } from "../../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = makeT(locale);
---

{/* Horizontal reading guide ruler */}
<div id="reading-guide" aria-hidden="true"></div>

{/* No floating trigger. The panel opens from the top bar (md and up) and from
    the mobile menu. A third, floating copy sat over the hero on every screen
    and covered the doctor's title. */}

{/* Visual Comfort & Accessibility Modal */}
<div
  id="a11y-modal"
  class="no-print fixed inset-0 z-50 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="a11y-modal-title"
  inert
>
  {/* Backdrop */}
  <div
    id="a11y-modal-backdrop"
    class="absolute inset-0 bg-ink/50 backdrop-blur-sm transition-opacity duration-300"
    data-a11y-close
  ></div>

  {/* Modal Dialog Card */}
  <div
    class="relative w-full max-w-lg overflow-hidden rounded-3xl border border-line bg-surface p-6 sm:p-8 shadow-2xl transition-all duration-300 scale-95"
    id="a11y-dialog-card"
  >
    {/* Modal Header */}
    <div class="flex items-start justify-between gap-4 border-b border-line/60 pb-5">
      <div class="flex items-center gap-3">
        <span class="grid h-10 w-10 shrink-0 place-items-center rounded-2xl bg-sand-soft text-bronze-deep">
          <Eye size={22} aria-hidden="true" />
        </span>
        <div>
          <h2 id="a11y-modal-title" class="font-display text-[1.28rem] font-bold text-ink">
            {t("a11y.menuTitle")}
          </h2>
          <p class="mt-1 text-[0.82rem] text-ink-muted">
            {t("a11y.menuSubtitle")}
          </p>
        </div>
      </div>

      <button
        type="button"
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-ink-muted transition-colors hover:bg-sand-soft hover:text-ink active:scale-95"
        data-a11y-close
        aria-label={t("a11y.close")}
      >
        <X size={19} aria-hidden="true" />
      </button>
    </div>

    {/* Controls Body */}
    <div class="mt-6 flex flex-col gap-6 max-h-[68vh] overflow-y-auto pe-1">
      {/* 1. Text Size Segmented Control */}
      <div>
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-[0.88rem] font-bold text-ink">
            <Type size={16} aria-hidden="true" class="text-bronze-deep" />
            <span>{t("a11y.textSize")}</span>
          </label>
        </div>

        <div class="mt-3 grid grid-cols-3 gap-2 rounded-2xl border border-line/70 bg-sand-soft/40 p-1.5" data-a11y-font-group>
          <button
            type="button"
            class="flex items-center justify-center rounded-xl py-2.5 text-[0.84rem] font-bold transition-all bg-surface text-ink shadow-2xs border border-line/60"
            data-a11y-font-btn="normal"
          >
            {t("a11y.sizeNormal")}
          </button>
          <button
            type="button"
            class="flex items-center justify-center rounded-xl py-2.5 text-[0.92rem] font-bold transition-all text-ink hover:bg-sand-soft"
            data-a11y-font-btn="lg"
          >
            {t("a11y.sizeLarge")}
          </button>
          <button
            type="button"
            class="flex items-center justify-center rounded-xl py-2.5 text-[1.02rem] font-bold transition-all text-ink hover:bg-sand-soft"
            data-a11y-font-btn="xl"
          >
            {t("a11y.sizeXLarge")}
          </button>
        </div>
      </div>

      {/* 2. Theme & Contrast Selection Cards */}
      <div>
        <label class="flex items-center gap-2 text-[0.88rem] font-bold text-ink">
          <Sparkles size={16} aria-hidden="true" class="text-bronze-deep" />
          <span>{t("a11y.contrastTitle")}</span>
        </label>

        <div class="mt-3 grid grid-cols-1 sm:grid-cols-3 gap-2.5" data-a11y-contrast-group>
          {/* Natural Theme */}
          <button
            type="button"
            class="flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-bronze bg-sand-soft/50 p-3.5 text-center transition-all"
            data-a11y-contrast-btn="normal"
          >
            <span class="h-6 w-6 rounded-full bg-[#f8f5ef] border border-line shadow-xs flex items-center justify-center text-ink text-xs font-bold">Aa</span>
            <span class="text-[0.82rem] font-bold text-ink">{t("a11y.contrastNormal")}</span>
          </button>

          {/* High Contrast */}
          <button
            type="button"
            class="flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-line bg-surface p-3.5 text-center transition-all hover:border-line/90"
            data-a11y-contrast-btn="high"
          >
            <span class="h-6 w-6 rounded-full bg-white border-2 border-black flex items-center justify-center text-black text-xs font-black">Aa</span>
            <span class="text-[0.82rem] font-bold text-ink">{t("a11y.contrastHigh")}</span>
          </button>

          {/* Dark Mode */}
          <button
            type="button"
            class="flex flex-col items-center justify-center gap-2 rounded-2xl border-2 border-line bg-surface p-3.5 text-center transition-all hover:border-line/90"
            data-a11y-contrast-btn="dark"
          >
            <span class="h-6 w-6 rounded-full bg-[#141311] border border-sand-ink/40 flex items-center justify-center text-[#fdfcf9] text-xs font-bold">Aa</span>
            <span class="text-[0.82rem] font-bold text-ink">{t("a11y.contrastDark")}</span>
          </button>
        </div>
      </div>

      {/* 3. Reading Guide Ruler Toggle */}
      <div class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-sand-soft/30 p-4">
        <div class="flex items-start gap-3">
          <Compass size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-bronze-deep" />
          <div>
            <span class="block text-[0.88rem] font-bold text-ink">{t("a11y.readingGuide")}</span>
            <span class="mt-0.5 block text-[0.78rem] text-ink-muted">{t("a11y.readingGuideDesc")}</span>
          </div>
        </div>

        <button
          type="button"
          role="switch"
          aria-checked="false"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-sand-ink/40 transition-colors duration-200 ease-in-out focus:outline-none"
          data-a11y-toggle="guide"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out translate-x-0 rtl:-translate-x-0"
            data-toggle-handle
          ></span>
        </button>
      </div>

      {/* 4. Enhanced Spacing Toggle */}
      <div class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-sand-soft/30 p-4">
        <div class="flex items-start gap-3">
          <SlidersVertical size={18} aria-hidden="true" class="mt-0.5 shrink-0 text-bronze-deep" />
          <div>
            <span class="block text-[0.88rem] font-bold text-ink">{t("a11y.spacingTitle")}</span>
            <span class="mt-0.5 block text-[0.78rem] text-ink-muted">{t("a11y.spacingDesc")}</span>
          </div>
        </div>

        <button
          type="button"
          role="switch"
          aria-checked="false"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-sand-ink/40 transition-colors duration-200 ease-in-out focus:outline-none"
          data-a11y-toggle="spacing"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out translate-x-0 rtl:-translate-x-0"
            data-toggle-handle
          ></span>
        </button>
      </div>
    </div>

    {/* Modal Footer */}
    <div class="mt-6 flex items-center justify-between border-t border-line/60 pt-4">
      <button
        type="button"
        class="inline-flex items-center gap-1.5 text-[0.82rem] font-semibold text-ink-muted transition-colors hover:text-ink active:scale-95"
        data-a11y-reset
      >
        <RotateCcw size={14} aria-hidden="true" />
        <span>{t("a11y.resetAll")}</span>
      </button>

      <button
        type="button"
        class="btn btn-primary !py-2 !px-5 text-[0.84rem]"
        data-a11y-close
      >
        {t("a11y.close")}
      </button>
    </div>
  </div>
</div>
